{
  "schema": "chrono-ci-check/v3",
  "judge": {
    "program": ".chrono-harness/bin/chrono-judge-ci",
    "args": [],
    "timeout_seconds": 600,
    "output_limit_bytes": 8388608
  },
  "report_path": ".chrono-harness/state/collection/check.json",
  "policy": {
    "filemap": ".chrono-harness/FILEMAP.json",
    "projects": ".chrono-harness/projects.json",
    "tools": {
      "python3": "python3",
      "chrono-ci": ".chrono-harness/bin/chrono-ci",
      "chrono-instructions": ".chrono-harness/bin/chrono-instructions",
      "go": ".chrono-harness/cache/sdk/go/go/bin/go",
      "node": ".chrono-harness/bin/node"
    },
    "artifacts": [
      ".chrono-harness/bin/",
      ".chrono-harness/state/",
      ".chrono-harness/cache/"
    ],
    "required_inputs": [
      ".chrono-harness/ci/check.json",
      ".chrono-harness/ci/units.json",
      ".chrono-harness/bootstrap.json",
      ".chrono-harness/bootstrap.py",
      ".github/workflows/chrono-ci.yml",
      ".chrono-harness/distribution.json",
      ".chrono-harness/install.py",
      ".chrono-harness/config.json",
      ".chrono-harness/judges.json",
      ".chrono-harness/workflow.json",
      ".chrono-harness/worktree.json",
      ".chrono-harness/git/macos.json",
      ".chrono-harness/git/linux.json",
      ".chrono-harness/git/global.config"
    ],
    "adoption_base": null,
    "operation_timeout_seconds": 120,
    "operation_output_limit_bytes": 1048576,
    "environment": {
      "GOTOOLCHAIN": "local",
      "GOWORK": "off",
      "GOPROXY": "off",
      "PYTHONDONTWRITEBYTECODE": "1"
    },
    "units": {
      "rates": {
        "tests": [
          "test:rates-tests"
        ],
        "report_path": ".chrono-harness/state/units/rates/check.json"
      },
      "labels": {
        "tests": [
          "test:labels-tests"
        ],
        "report_path": ".chrono-harness/state/units/labels/check.json"
      },
      "normalize": {
        "tests": [
          "test:normalize-tests"
        ],
        "report_path": ".chrono-harness/state/units/normalize/check.json"
      },
      "harness": {
        "tests": [
          "test:bootstrap-tests"
        ],
        "report_path": ".chrono-harness/state/units/harness/check.json"
      }
    },
    "shared_operations": {},
    "registration_config": ".chrono-harness/config.json",
    "facts_config": ".chrono-harness/config.json"
  }
}
